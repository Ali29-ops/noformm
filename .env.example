# --- Required ---------------------------------------------------------------
# First admin account (created once, on first boot, if no admin exists).
ADMIN_EMAIL=studio@noform.design
ADMIN_PASSWORD=change-me-to-something-long

# Public URL used in emails, sitemap, and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Local SQLite file by default. For production point this at Turso/libSQL:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/noform.db
# DATABASE_AUTH_TOKEN=

# --- Email (Resend) ---------------------------------------------------------
# Leave empty to keep emails in the admin Mail outbox without sending.
# RESEND_API_KEY=re_...
# EMAIL_FROM="NO FORM <studio@noform.design>"
# EMAIL_REPLY_TO=studio@noform.design

# --- Payments (Paymob) — to be added ---------------------------------------
# Setting these opens the card option at checkout.
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=

# --- Shipping (Bosta) -------------------------------------------------------
# Setting the key opens “Create Bosta shipment” on admin orders.
# Staging: https://stg-app.bosta.co/api/v2
# BOSTA_API_KEY=
# BOSTA_API_URL=https://app.bosta.co/api/v2
# Bosta dashboard → webhook: <site>/api/webhooks/bosta with header Authorization = this value.
# BOSTA_WEBHOOK_SECRET=
